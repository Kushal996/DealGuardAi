<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>statusUpdate</name>
        <label>statusUpdate</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>statusOutputVariable</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaStatus</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>This is a Record-Triggered Flow.
This flow is triggered when a record is updated. It takes two input variables: &apos;quoteStatus&apos; and &apos;recordId&apos;. It then updates the &apos;Status&apos; field of the Quote record with the value provided in &apos;quoteStatus&apos;. The flow also creates a formula &apos;updatestatus&apos; that concatenates a string with the new status value.

Several objects and their fields worth mentioning. Below are the details (the format is given as: object_name - field_name: interaction)
  * Quote - Status : Updated based on input variable &apos;quoteStatus&apos;</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaStatus</name>
        <dataType>String</dataType>
        <expression>&apos;Quote Status Updated to &apos; + {!quoteStatus} + &apos; value&apos;</expression>
    </formulas>
    <interviewLabel>Update Quote Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Quote Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Quote_Status</name>
        <label>Update Quote Status</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>statusUpdate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>quoteStatus</elementReference>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Quote_Status</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>quoteStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>statusOutputVariable</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
